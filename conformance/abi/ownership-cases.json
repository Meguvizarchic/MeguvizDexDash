        {
          "op": "view",
          "fn": "mdd_error_json_v1",
          "args": [
            "err"
          ],
          "expect": "OK"
        },
        {
          "op": "call",
          "fn": "mdd_error_release",
          "args": [
            "err"
          ],
          "expect": "OK"
        },
        {
          "op": "call",
          "fn": "mdd_error_release",
          "args": [
            "err"
          ],
          "expect": "INVALID_HANDLE"
        }
      ]
    }
