  "allowed_platform_differences": [
    {
      "id": "EXECUTABLE_AND_SHARED_LIB_NAMES",
      "description": "Windows uses .exe and mdd_ffi.dll; Linux uses bare executable name and libmdd_ffi.so."
    },
    {
      "id": "HOST_SOURCE_PATH_SYNTAX",
      "description": "Raw OS file paths echoed in dex_files.source_path and snapshot origin_display differ by filesystem separator and host directory root; canonical_workloads normalize paths to POSIX repo-relative strings while keeping archive entry_name exact."
    },
    {
      "id": "FORCED_WORKER_KILL_EXIT_CODE",
      "description": "Killing a hung or mid-stream worker yields SIGKILL signal status (-9/137) on Linux and a non-zero Win32 termination code on Windows; Python SDK maps both to WORKER_LOST."
    },
    {
      "id": "DESKTOP_WEBVIEW_RUNTIME",
      "description": "Desktop shell uses WebKitGTK (+ Xvfb in CI) on Linux and WebView2 CDP on Windows; both drive the exact same 12-tool MCP stdio subprocess protocol."
    }
  ],
