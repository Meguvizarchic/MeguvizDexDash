 "get_manifest": {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "inputSchema": {
   "$defs": {
    "ManifestMode": {
     "description": "Which `AndroidManifest.xml` view a `get_manifest` request asks for.\n\n`JsonSchema` is derived here because the MCP tool definition is generated from this type (it is\nre-exported as `cli::mcp::protocol::ManifestMode`), so the published parameter schema and the\nimplemented behaviour cannot disagree.",
     "oneOf": [
      {
       "const": "summary",
       "description": "Structured summary: manifest/application/uses-sdk attributes, target SDK, component counts,\nand a paged `permissions` list.",
       "type": "string"
      },
      {
       "const": "xml",
       "description": "The complete decoded XML, paged by UTF-8 byte offset.",
       "type": "string"
      }
     ]
    }
   },
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "dataset_id": {
     "type": "string"
    },
    "input_index": {
     "description": "Index in open_dataset.inputs; required when several archive inputs are present.",
     "format": "uint",
     "minimum": 0,
     "type": [
      "integer",
      "null"
     ]
    },
    "limit": {
     "format": "uint",
     "maximum": 200,
     "minimum": 1,
     "type": [
      "integer",
      "null"
     ]
    },
    "max_bytes": {
     "format": "uint",
     "minimum": 0,
     "type": [
      "integer",
      "null"
     ]
    },
    "mode": {
     "$ref": "#/$defs/ManifestMode",
     "default": "summary"
    },
    "offset": {
     "default": 0,
     "description": "Permission-row offset in summary mode, UTF-8 byte offset in XML mode.",
     "format": "uint",
     "minimum": 0,
     "type": "integer"
    },
    "timeout_ms": {
     "format": "uint64",
     "minimum": 0,
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "required": [
    "dataset_id"
   ],
   "type": "object"
  }
 },
