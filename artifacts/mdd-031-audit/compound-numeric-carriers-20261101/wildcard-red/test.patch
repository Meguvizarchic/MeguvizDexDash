+                .map(|row| row[0].clone())
+                .collect::<Vec<_>>();
+            assert_eq!(actual, expected_native, "{dialect:?}: native UTF-16 order");
+        }
+        // SQLite's BINARY order is a distinct observation; the legacy DexSQL
+        // order is not established by this check and remains unqualified.
+    }
